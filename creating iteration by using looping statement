      ],
      "source": [
        "choice = int(input(\"Enter your choice: \"))\n",
        "n = int(input(\"Enter number of rows: \"))\n",
        "\n",
        "if choice == 1:\n",
        "    for i in range(1, n + 1):\n",
        "        print(\"* \" * i)\n",
        "\n",
        "elif choice == 2:\n",
        "    for i in range(1, n + 1):\n",
        "        print(\"  \" * (n - i) + \"* \" * i)\n",
        "\n",
        "elif choice == 3:\n",
        "    for i in range(1, n + 1):\n",
        "        print(\" \" * (n - i) + \"* \" * i)\n",
        "\n",
        "else:\n",
        "    print(\"Invalid choice\")"
      ]
    }
